# B.I.R.D — Environment Variables
# Copy this file to .env and fill in your values.
# For LOCAL development: use the Neon connection string below
# For VERCEL: add these as Environment Variables in the Vercel dashboard
#
# NEVER commit the real .env file — it is gitignored. Rotate any secret
# that has ever been committed (git history is public once pushed).

# ─── Database ────────────────────────────────────────────────────────────────
# Get this from https://neon.tech → Your Project → Connection String
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Must be >= 32 chars and must NOT be a value that was ever
# committed to git. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
# Used ONLY server-side (server.ts / api/index.ts) — never exposed to the browser.
GEMINI_API_KEY=""

# ─── Admin account ────────────────────────────────────────────────────────────
# Password for the seeded admin@bird.ai account. If unset, a random password
# is generated at boot and printed to the server logs once.
ADMIN_PASSWORD=""

# ─── Seeding ──────────────────────────────────────────────────────────────────
# Demo founder/investor accounts (password123) are dev-only.
# In production they are skipped unless this is "true".
# SEED_DEMO_USERS="false"

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allow-list. Empty = same-origin only (recommended).
# CORS_ORIGIN="https://yourdomain.com"
