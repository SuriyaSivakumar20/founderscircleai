{
  "name": "founderscircle-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx server.ts",
    "build": "vite build",
    "vercel-build": "prisma generate && prisma db push && npx tsx backend/utils/runSeed.ts && vite build",
